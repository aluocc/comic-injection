# ---- Backend environment template ----
# Copy to `.env` and adjust values for your local setup.

# HTTP port the NestJS server listens on
PORT=3001

# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/learning_platform?schema=public"

# Redis connection string (ioredis)
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-in-production"
JWT_EXPIRES_IN="7d"

# CORS — comma-separated list of allowed origins (leave empty for *)
# Example: CORS_ORIGIN="http://localhost:3000,https://app.example.com"
CORS_ORIGIN=""
